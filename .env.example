# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase.
# Project Settings -> API en el panel de Supabase.

# URL del proyecto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable / anon (segura para el frontend, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# NOTA: la clave secreta (sb_secret_...) NO se usa en el frontend ni se versiona.
# Solo iría en un entorno server de confianza si alguna vez se necesita.
